{
    "name": "mracos/phpunit-run-failed",
    "description": "PHPUnit extension to re-run only failed tests",
    "type": "phpunit-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcos Ferreira",
            "email": "marcosp4f@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PhpUnitRunFailed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpUnitRunFailed\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --no-progress",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "extra": {
        "phpunit": {
            "extensions": [
                "PhpUnitRunFailed\\FailedTestRerunnerExtension"
            ]
        }
    }
}
